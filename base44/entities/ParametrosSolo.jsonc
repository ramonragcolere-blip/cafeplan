{
  "name": "ParametrosSolo",
  "type": "object",
  "properties": {
    "codigo_produtor": {
      "type": "string",
      "description": "C\u00f3digo do produtor"
    },
    "talhao_id": {
      "type": "string",
      "description": "ID do talh\u00e3o. Vazio quando aplic\u00e1vel a toda a fazenda."
    },
    "talhao_nome": {
      "type": "string",
      "description": "Nome do talh\u00e3o"
    },
    "safra": {
      "type": "string",
      "description": "Safra de refer\u00eancia"
    },
    "profundidade": {
      "type": "string",
      "enum": [
        "0-20",
        "20-40",
        "0-40"
      ],
      "description": "Profundidade de interpreta\u00e7\u00e3o dos par\u00e2metros"
    },
    "nutrientes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "unidade_escolhida": {
            "type": "string"
          },
          "minimo": {
            "type": "number"
          },
          "ideal": {
            "type": "number"
          },
          "maximo": {
            "type": "number"
          }
        }
      },
      "description": "Par\u00e2metros por nutriente: { key, nome, unidade_escolhida, minimo, ideal, maximo }"
    }
  },
  "required": [
    "codigo_produtor",
    "profundidade"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}