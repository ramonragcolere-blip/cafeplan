{
  "name": "MovimentoEstoqueInsumo",
  "type": "object",
  "properties": {
    "produtor_id": {
      "type": "string",
      "description": "ID do produtor (estoque \u00e9 por produtor)"
    },
    "produto_id": {
      "type": "string",
      "description": "ID do produto na Base de Insumos (FertilizanteFormulado/FonteSimples) quando houver rela\u00e7\u00e3o"
    },
    "produto_tipo": {
      "type": "string",
      "enum": [
        "fert",
        "fonte",
        "nf"
      ],
      "description": "Origem do produto: fert=FertilizanteFormulado, fonte=FonteSimples, nf=apenas nome da NF"
    },
    "produto_nome": {
      "type": "string",
      "description": "Nome do produto (da NF quando sem rela\u00e7\u00e3o)"
    },
    "tipo_movimento": {
      "type": "string",
      "enum": [
        "saida",
        "ajuste"
      ],
      "default": "saida",
      "description": "Tipo de movimento: sa\u00edda de estoque ou ajuste"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade movimentada (na unidade do produto)"
    },
    "unidade": {
      "type": "string",
      "description": "Unidade da quantidade (mesma unidade usada no saldo do produto)"
    },
    "data_movimento": {
      "type": "string",
      "format": "date",
      "description": "Data do movimento"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o livre"
    }
  },
  "required": [
    "produtor_id",
    "produto_nome",
    "produto_tipo",
    "tipo_movimento",
    "quantidade",
    "unidade",
    "data_movimento"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}