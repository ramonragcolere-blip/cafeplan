      "description": "Dados da an\u00e1lise 20-40cm"
    },
    "doses_editadas": {
      "type": "object",
      "description": "Doses editadas manualmente pelo usu\u00e1rio { N, P, K, B, Zn, Cu, Mn, Fe, Mg }"
    },
    "detalhamento": {
      "type": "object",
      "description": "Detalhamento por nutriente: produto, parcelamento, meses, pre\u00e7o"
    },
    "rastreabilidade_replicacao": {
      "type": "object",
      "description": "Metadados compat\u00edveis da replica\u00e7\u00e3o de recomenda\u00e7\u00e3o entre talh\u00f5es"
