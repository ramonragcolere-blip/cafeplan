{
  "name": "BaseRecomendacaoGessagem",
  "type": "object",
  "properties": {
    "codigo_produtor": {
      "type": "string",
      "description": "C\u00f3digo do produtor"
    },
    "safra": {
      "type": "string",
      "description": "Safra agr\u00edcola"
    },
    "talhao_id": {
      "type": "string",
      "description": "ID do talh\u00e3o"
    },
    "talhao_nome": {
      "type": "string",
      "description": "Nome do talh\u00e3o"
    },
    "ca_2040": {
      "type": "number",
      "description": "Ca em 20-40 cm (cmolc/dm\u00b3)"
    },
    "al_2040": {
      "type": "number",
      "description": "Al em 20-40 cm (cmolc/dm\u00b3)"
    },
    "saturacao_aluminio": {
      "type": "number",
      "description": "m% em 20-40 cm"
    },
    "magnesio_2040": {
      "type": "number",
      "description": "Mg em 20-40 cm (cmolc/dm\u00b3)"
    },
    "potassio_2040": {
      "type": "number",
      "description": "K em 20-40 cm (mg/dm\u00b3)"
    },
    "argila_pct": {
      "type": "number",
      "description": "Teor de argila (%)"
    },
    "dose_calcario_kg_ha": {
      "type": "number",
      "description": "Dose de calc\u00e1rio considerada no m\u00e9todo Lopes (kg/ha)"
    },
    "cao_calcario_pct": {
      "type": "number",
      "description": "CaO do calc\u00e1rio (%)"
    },
    "cao_gesso_pct": {
      "type": "number",
      "description": "CaO do gesso (%)"
    },
    "metodo_calculo": {
      "type": "string",
      "description": "Metodo selecionado: combinado_conservador, 5a_aproximacao, lopes ou dose_manual"
    },
    "faixa_5a_posicao": {
      "type": "string",
      "description": "Posicao escolhida na faixa da 5a Aproximacao: minima, media ou maxima"
    },
    "indicada": {
      "type": "boolean",
      "description": "Indica se a an\u00e1lise 20-40 cm recomenda gessagem"
    },
    "motivos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Crit\u00e9rios que indicaram gessagem"
    },
    "faixa_5a_min_t_ha": {
      "type": "number",
      "description": "Faixa m\u00ednima da 5\u00aa Aproxima\u00e7\u00e3o (t/ha)"
    },
    "faixa_5a_max_t_ha": {
      "type": "number",
      "description": "Faixa m\u00e1xima da 5\u00aa Aproxima\u00e7\u00e3o (t/ha)"
    },
    "dose_lopes_kg_ha": {
      "type": "number",
      "description": "Dose calculada pelo m\u00e9todo Lopes (kg/ha)"
    },
    "calcario_ajustado_kg_ha": {
      "type": "number",
      "description": "Calc\u00e1rio ajustado no m\u00e9todo Lopes (kg/ha)"
    },
    "dose_matematica_kg_ha": {
      "type": "number",
      "description": "Resultado matematico do metodo selecionado (kg/ha)"
    },
    "dose_tecnica_kg_ha": {
      "type": "number",
      "description": "Dose tecnica sugerida quando a analise indica gessagem (kg/ha)"
    },
    "aplicar_sem_indicacao_tecnica": {
      "type": "boolean",
      "description": "Permite dose manual mesmo sem indicacao tecnica pela analise 20-40 cm"
    },
    "dose_sugerida_kg_ha": {
      "type": "number",
      "description": "Dose t\u00e9cnica sugerida (kg/ha)"
    },
    "dose_final_kg_ha": {
      "type": "number",
      "description": "Dose final escolhida pelo t\u00e9cnico (kg/ha)"
    },
    "produto_id": {
      "type": "string",
      "description": "ID da fonte de gesso"
    },
    "produto_nome": {
      "type": "string",
      "description": "Nome da fonte de gesso"
    },
    "produto_calcario_id": {
      "type": "string",
      "description": "ID do corretivo importado da Calagem"
    },
    "produto_calcario_nome": {
      "type": "string",
      "description": "Nome do corretivo importado da Calagem"
    },
    "preco_calcario_unitario": {
      "type": "number",
      "description": "Preco unitario do calcario importado da Calagem"
    },
    "unidade_preco_calcario": {
      "type": "string",
      "description": "Unidade do preco do calcario importado: t ou kg"
    },
    "prnt_calcario": {
      "type": "number",
      "description": "PRNT do corretivo importado da Calagem (%)"
    },
    "ca_calcario_pct": {
      "type": "number",
      "description": "Ca elemental do corretivo importado da Calagem (%)"
    },
    "mg_calcario_pct": {
      "type": "number",
      "description": "Mg elemental do corretivo importado da Calagem (%)"
    },
    "preco_unitario": {
      "type": "number",
      "description": "Pre\u00e7o unit\u00e1rio informado pelo usu\u00e1rio"
    },
    "unidade_preco": {
      "type": "string",
      "description": "Unidade do pre\u00e7o: t ou kg"
    },
    "quantidade_total_kg": {
      "type": "number",
      "description": "Quantidade total no talh\u00e3o (kg)"
    },
    "custo_ha": {
      "type": "number",
      "description": "Custo por hectare"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total do talh\u00e3o"
    },
    "ca_fornecido_kg_ha": {
      "type": "number",
      "description": "Ca fornecido pelo gesso (kg/ha)"
    },
    "s_fornecido_kg_ha": {
      "type": "number",
      "description": "S fornecido pelo gesso (kg/ha)"
    },
    "orientacao": {
      "type": "string",
      "description": "Orienta\u00e7\u00e3o de aplica\u00e7\u00e3o"
    },
    "alerta_lixiviacao": {
      "type": "string",
      "description": "Alerta t\u00e9cnico sobre Mg e K"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es livres"
    },
    "rastreabilidade_replicacao": {
      "type": "object",
      "description": "Metadados compat\u00edveis da replica\u00e7\u00e3o de recomenda\u00e7\u00e3o entre talh\u00f5es"
    }
  },
  "required": [
    "codigo_produtor",
    "safra",
    "talhao_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}